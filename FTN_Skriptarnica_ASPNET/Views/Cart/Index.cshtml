@model List<FTN_Skriptarnica_ASPNET.Models.CartItem>

@{
    ViewData["Title"] = "Korpa";
}

<h2 class="mb-4">
    Moja Korpa
</h2>

@if (TempData["Success"] is string success){
    <div class="alert alert-success">@success</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.Count == 0){
    <p>Korpa je prazna</p>
}
else{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Proizvod</th>
                <th>Cena</th>
                <th>Kolicina</th>
                <th>Ukupno</th>
            </tr>
        </thead>

        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("N2") RSD</td>
                    <td>@item.Quantity</td>
                    <td>@item.TotalPrice.ToString("N2") RSD</td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="text-end">
        Ukupno: 
        @Model.Sum(x => x.TotalPrice).ToString("N2") RSD
    </h4>
}

<a asp-controller="Products"
   asp-action="Index"
   class="btn btn-outline-success mt-3">
   Nastavi kupovinu
</a>