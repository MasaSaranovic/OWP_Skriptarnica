@model List<FTN_Skriptarnica_ASPNET.Models.CartItem>



@{

    ViewData["Title"] = "Korpa";

    var total = Model.Sum(x => x.TotalPrice);

}



<div class="container py-4 cart-page">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">

        <div>

            <h1 class="h2 fw-bold mb-1 cart-title">Moja korpa</h1>

            <p class="text-muted mb-0">Pregled proizvoda koje ste izabrali.</p>

        </div>

        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-success">

            Nastavi kupovinu

        </a>

    </div>



    @if (TempData["Success"] is string success)

    {

        <div class="alert alert-success" role="status">@success</div>

    }

    @if (TempData["Error"] is string error)

    {

        <div class="alert alert-danger" role="alert">@error</div>

    }



    @if (Model == null || Model.Count == 0)

    {

        <div class="card border-0 shadow-sm cart-empty">

            <div class="card-body text-center py-5">

                <h2 class="h4">Korpa je prazna</h2>

                <p class="text-muted">Dodajte proizvod iz ponude da biste nastavili.</p>

                <a asp-controller="Products" asp-action="Index" class="btn btn-success">

                    Pogledaj proizvode

                </a>

            </div>

        </div>

    }

    else

    {

        <div class="card border-0 shadow-sm cart-panel">

            <div class="card-body p-3 p-md-4">

                <div class="table-responsive">

                    <table class="table table-hover align-middle cart-table mb-0">

                        <thead class="table-light">

                            <tr>

                                <th scope="col">Proizvod</th>

                                <th scope="col" class="text-nowrap">Cena po komadu</th>

                                <th scope="col">Kolicina</th>

                                <th scope="col" class="text-nowrap">Ukupno</th>

                                <th scope="col">Akcija</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)

                            {

                                <tr>

                                    <td class="fw-semibold">@item.Name</td>

                                    <td class="text-nowrap">@item.Price.ToString("N2") RSD</td>

                                    <td>

                                        <div class="d-inline-flex align-items-center gap-2">

                                            <form asp-controller="Cart" asp-action="ChangeQuantity" method="post">

                                                <input type="hidden" name="productId" value="@item.ProductId" />

                                                <input type="hidden" name="change" value="-1" />

                                                <button class="btn btn-sm btn-outline-secondary" type="submit" aria-label="Smanji kolicinu">−</button>

                                            </form>

                                            <span class="fw-semibold">@item.Quantity</span>

                                            <form asp-controller="Cart" asp-action="ChangeQuantity" method="post">

                                                <input type="hidden" name="productId" value="@item.ProductId" />

                                                <input type="hidden" name="change" value="1" />

                                                <button class="btn btn-sm btn-outline-secondary" type="submit" aria-label="Povecaj kolicinu">+</button>

                                            </form>

                                        </div>

                                    </td>

                                    <td class="text-nowrap fw-semibold">@item.TotalPrice.ToString("N2") RSD</td>

                                    <td>

                                        <form asp-controller="Cart" asp-action="Remove" method="post">

                                            <input type="hidden" name="productId" value="@item.ProductId" />

                                            <button class="btn btn-sm btn-outline-danger" type="submit">Ukloni</button>

                                        </form>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>



                <div class="row align-items-center g-3 border-top mt-3 pt-3 cart-summary">

                    <div class="col-md">

                        <span class="text-muted">Ukupno za placanje</span>

                        <div class="h4 fw-bold mb-0 cart-total">@total.ToString("N2") RSD</div>

                    </div>

                    <div class="col-md-auto">

                        <form asp-controller="Cart" asp-action="Clear" method="post">

                            <button class="btn btn-outline-danger" type="submit">Isprazni korpu</button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    }

</div>
