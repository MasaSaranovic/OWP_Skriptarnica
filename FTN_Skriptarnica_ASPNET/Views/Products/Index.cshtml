@model List<FTN_Skriptarnica_ASPNET.Models.Product>

@{
    ViewData["Title"] = "Proizvodi";
}

<div class="mb-4">
    <h2>Naši proizvodi</h2>
    <p class="text-muted">
        Pronađi knjige, skripte, pribor i FTN merch.
    </p>
</div>

<div class="row g-4">

    @foreach (var product in Model)
    {
        <div class="col-md-6 col-lg-4">

            <div class="card product-card h-100">

                <div class="card-body p-4">

                    <span class="badge bg-light text-dark border mb-3">
                        @product.Category
                    </span>

                    <h5 class="card-title">
                        @product.Name
                    </h5>

                    <p class="text-muted small">
                        @product.Description
                    </p>

                    <h5 class="mt-4">
                        @product.Price.ToString("N0") RSD
                    </h5>

                    <a asp-controller="Products"
                       asp-action="Details"
                       asp-route-id="@product.Id"
                       class="btn btn-outline-success w-100 mt-2">
                        Pogledaj detalje
                    </a>

                </div>

            </div>
        </div>
    }

</div>